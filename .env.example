# Copy to .env.local for local development and to Vercel project settings for deployment.
# Never commit real values. Everything here is server-side: do not add NEXT_PUBLIC_ prefixes to secrets.

# MongoDB Atlas connection string (mongodb+srv://...). Server only.
MONGODB_URI=
MONGODB_DB_NAME=quickdrop

# Random string, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Canonical origin of this deployment. Use https:// in production.
APP_URL=http://localhost:3000

# Email over SMTP (password reset and notifications). Defaults are for Gmail.
# SMTP_PASS must be a Google app password (not your normal password).
# Without SMTP_USER and SMTP_PASS, development prints emails to the terminal and production refuses to send them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to QuickDrop <SMTP_USER>.
EMAIL_FROM=

# Cloudinary uploads. The API secret must stay server-side.
# Without these, uploads show a "not set up yet" message and the rest of the app still works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional per-account storage limit in MB. When set, the sidebar shows a usage bar, warns at 80%,
# and refuses uploads that would go over it. Leave blank for no limit.
STORAGE_LIMIT_MB=

# Optional. Enables the daily cleanup of unsaved uploads (/api/cron/cleanup-uploads, see vercel.json).
# Random string, at least 16 characters. Vercel sends it automatically when set in the project settings.
CRON_SECRET=

# Optional feature flag: in-browser video compression (FFmpeg.wasm). "on" lets users opt in under
# Settings; anything else (or blank) keeps it off. Each user still has to turn it on themselves.
